<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Information -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>

	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>

	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>

	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Privacy Usage Descriptions - REQUIRED -->

	<!-- Screen Recording Permission -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Productivity Tracker needs to access browser URLs to categorize your web activity accurately. Your data stays private and is never shared.</string>

	<!-- Automation Permission -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>Productivity Tracker needs Screen Recording permission to read window titles for accurate activity tracking. Your data is stored locally and never leaves your device.</string>

	<!-- App Behavior -->

	<!-- Set to true to run as menubar-only app (no Dock icon) -->
	<key>LSUIElement</key>
	<false/>

	<!-- Minimum macOS Version -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- App Category for App Store -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>

	<!-- Document Types (if needed) -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<!-- Add document types here if your app opens files -->
	</array>

	<!-- URL Schemes (if needed) -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Add URL schemes here if needed -->
	</array>

	<!-- Launch at Login Support -->
	<key>LSBackgroundOnly</key>
	<false/>

	<!-- High Resolution Support -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Human-Readable Copyright -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2024. All rights reserved.</string>
</dict>
</plist>
