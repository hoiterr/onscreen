{
  "name": "tarkov-overlay-app",
  "version": "0.1.0",
  "description": "Real-time position tracking and quest overlay for Escape from Tarkov",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "webpack serve --mode development",
    "build": "tsc && webpack --mode production",
    "build:electron": "electron-builder",
    "watch": "tsc -w"
  },
  "keywords": [
    "tarkov",
    "overlay",
    "map",
    "quest"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "css-loader": "^7.1.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "socket.io": "^4.6.0",
    "socket.io-client": "^4.6.0"
  },
  "build": {
    "appId": "com.tarkovoverlay.app",
    "productName": "Tarkov Overlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "data/**/*",
      "index.html",
      "overlay.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    }
  }
}
